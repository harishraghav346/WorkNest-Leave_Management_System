# ==============================================================================
# WorkNest Environment Configuration Template (.env.example)
# DO NOT COMMIT REAL SECRETS TO SOURCE CONTROL
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Spring Profile Configuration
# ------------------------------------------------------------------------------
# Use 'dev' for local developer environment (H2 console enabled, mock seeds permitted)
# Use 'prod' for production environment (hardened security, fail-closed secrets)
SPRING_PROFILES_ACTIVE=prod

# ------------------------------------------------------------------------------
# 2. JWT Signing Secret (CRITICAL FOR PRODUCTION)
# ------------------------------------------------------------------------------
# In production ('prod' or 'production' profile), JWT_SECRET is strictly REQUIRED.
# Must provide at least 32 bytes (256 bits) of cryptographically secure key material.
# If missing, blank, or shorter than 32 bytes, the application will terminate on startup.
#
# Secret Interpretation:
#   - By default, JWT_SECRET is interpreted as raw UTF-8 text (requires >= 32 UTF-8 characters/bytes).
#   - To supply binary key material in Base64 encoding, prefix with 'base64:' (e.g. base64:AbCd...==).
#
# How to generate a secure 32-byte (256-bit) cryptographic secret:
#   PowerShell (Cryptographically Secure via RandomNumberGenerator):
#     $b = New-Object byte[] 32; [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [System.BitConverter]::ToString($b).Replace('-','').ToLower()
#   Bash / Linux / OpenSSL:
#     openssl rand -hex 32
#   Or for Base64 (prefix with base64:):
#     openssl rand -base64 32
JWT_SECRET=replace_with_at_least_32_bytes_cryptographically_secure_random_key_here

# JWT Expiration in milliseconds (Default: 86400000 = 24 hours)
JWT_EXPIRATION=86400000

# ------------------------------------------------------------------------------
# 3. Initial Administrator Provisioning (PRODUCTION BOOTSTRAP)
# ------------------------------------------------------------------------------
# Used ONLY during first-time deployment when zero administrator accounts exist.
# Once an admin exists in the database, these variables are ignored.
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=replace_with_strong_temporary_admin_password

# ------------------------------------------------------------------------------
# 4. Database Connection (H2 persistent by default; MySQL / PostgreSQL in prod)
# ------------------------------------------------------------------------------
# H2 persistent database path (default):
DB_URL=jdbc:h2:file:./data/leavetracker;AUTO_SERVER=TRUE
DB_DRIVER=org.h2.Driver
DB_USERNAME=sa
DB_PASSWORD=

# ------------------------------------------------------------------------------
# 5. CORS Allowed Origins
# ------------------------------------------------------------------------------
# Comma-separated list of trusted client origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:5173

# ==============================================================================
# WINDOWS POWERSHELL RUN INSTRUCTIONS:
# ==============================================================================
# 1. Local Development:
#    $env:SPRING_PROFILES_ACTIVE="dev"
#    .\mvnw.cmd spring-boot:run
#
# 2. Production Launch:
#    $env:SPRING_PROFILES_ACTIVE="prod"
#    $env:JWT_SECRET="YourSecureGeneratedSecretOfAtLeast32BytesLengthGoesHere!"
#    $env:ADMIN_INITIAL_PASSWORD="YourStrongInitialAdminPassword123!"
#    .\mvnw.cmd spring-boot:run
# ==============================================================================
